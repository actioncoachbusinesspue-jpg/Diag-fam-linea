# Diagnóstico BVM — protección de la carpeta pública
Options -Indexes

# Encabezados de seguridad (refuerzo; PHP también los envía)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>

# Nunca servir archivos sensibles si terminaran aquí por error
<FilesMatch "\.(sql|sqlite|json\.bak|bak|ini|log|sh|env)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|config\.example)\.php$">
  Require all denied
</FilesMatch>
